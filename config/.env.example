# Kalshi API credentials
# NEVER commit the actual .env file to git
KALSHI_API_KEY_ID=your-key-id-here
KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi_private_key.pem

# Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXX

# Polymarket wallet private key (for USDC on Polygon trading)
POLYMARKET_PRIVATE_KEY=

# Serper.dev API key for news research (optional — degrades gracefully)
# 2,500 free queries, no credit card required: https://serper.dev
SERPER_API_KEY=

# FRED API key for economic data (optional — free registration at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Metaculus API token (optional — for community forecast cross-reference)
METACULUS_API_TOKEN=

# SearXNG instance URL (optional — alternative search backend)
# SEARXNG_URL=http://localhost:8888

# iMessage alert endpoint (optional — for VAYU iMessage infrastructure)
# NOTE: Set this in config/settings.yaml under alerts.imessage_endpoint, not here.
# IMESSAGE_ENDPOINT=http://localhost:3000/send

# Dashboard API key for authentication (optional — unauthenticated if not set)
# POLYEDGE_DASHBOARD_KEY=your-secret-key

# Dashboard CORS origins (optional — comma-separated, defaults to localhost)
# POLYEDGE_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Safety gate for live trading (must be explicitly set)
POLYEDGE_LIVE_ENABLED=false

# Polymarket residency gate (required for non-US traders using Polymarket)
# Set to "true" ONLY if you confirm you are NOT a US resident/citizen.
# Polymarket is not available to US persons per CFTC regulations.
CONFIRM_NON_US_POLYMARKET=false
